{
	"name": "service-worker-toolkit",
	"version": "0.0.0",
	"private": true,
	"description": "Configure a service worker's caching rules and see what they would do to a real site's requests before deploying anything.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"check": "npm run typecheck && npm run lint && npm run test",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@stylistic/eslint-plugin": "^6.0.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"eslint": "^10.15.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"lit": "^3.3.3"
	}
}
